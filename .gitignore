ios/.build/
ios/.swiftpm/
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/DerivedData/
*.xcuserstate
xcuserdata/

# --- tooling caches that live in the workspace ------------------------------
.cache/
.local/
.config/
.npm/
.sudo_as_admin_successful

# --- editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- SwiftPM machine-local state -------------------------------------------
.swiftpm/
